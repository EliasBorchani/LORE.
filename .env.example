POSTGRES_PASSWORD=change-me
# Signs access tokens, at least 32 bytes: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-bytes
# For cargo test and cargo run on the host, against the Compose database.
DATABASE_URL=postgres://dnd:change-me@localhost:5433/dnd
# Production only (compose.prod.yaml): the address of the app; its DNS record must point to the server.
LORE_DOMAIN=lore.example.org
# Production backups (deploy/backup.sh): where to copy each export, as an rsync target. Empty = keep them local only.
BACKUP_REMOTE=
