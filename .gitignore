# Build outputs and caches (regenerated by every build)
build/
.gradle/
.kotlin/
**/target/
node_modules/
dist/
*.tsbuildinfo

# Generated from the design tokens (npm run tokens)
apps/web/src/theme/tokens.css

# Secrets and personal settings
.env
.envrc
local.properties

# Database copies: they hold every account's password hash
exports/

# Scraper working material: the source site's pages and extracted text are never committed
content/tools/cache/
content/tools/out/
content/tools/spells/chunks/

# Editors and systems
.idea/
*.iml
.vscode/
.DS_Store
