      "key": "ac.total",
      "base": "10 + @ac.armor + @ac.shield + @ac.natural + @ac.dex_bonus + @size.modifier"
    },
    {
      "key": "caster_level.class[*]",
      "base": 0
    },
    {
      "key": "caster_level.wizard",
      "base": "level('class.wizard') + @spellcasting.advances[class.wizard] + @caster_level.arcane + @caster_level.class[class.wizard]"
    },
    {
      "key": "caster_level.sorcerer",
      "base": "level('class.sorcerer') + @spellcasting.advances[class.sorcerer] + @caster_level.arcane + @caster_level.class[class.sorcerer]"
    },
    {
      "key": "size",
      "base": "'medium'"
    },
    {
      "key": "size.steps",
      "base": "if(@size == 'fine', -4, if(@size == 'diminutive', -3, if(@size == 'tiny', -2, if(@size == 'small', -1, if(@size == 'large', 1, if(@size == 'huge', 2, if(@size == 'gargantuan', 3, if(@size == 'colossal', 4, 0))))))))"
    },
    {
      "key": "size.modifier",
      "base": "if(@size == 'fine', 8, if(@size == 'diminutive', 4, if(@size == 'tiny', 2, if(@size == 'small', 1, if(@size == 'large', -1, if(@size == 'huge', -2, if(@size == 'gargantuan', -4, if(@size == 'colossal', -8, 0))))))))"
    },
    {
      "key": "weapon.size_steps",
      "base": "@size.steps"
    },
    {
      "key": "weapon.damage",
      "diceSteps": "@weapon.size_steps"
    },
    {
      "key": "unarmed.damage",
      "diceSteps": "@size.steps"
    },
    {
      "key": "initiative",
      "components": [
        "ability.dex.mod"
      ]
    },
    {
      "key": "feat_slots.general",
      "base": "1 + floor(min(level(), 20) / 3)"
    },
    {
      "key": "feat_slots.epic",
      "base": "max(0, floor(level() / 3) - 6)"
    }
