  "progressionRules": {
    "epicAfterLevel": 20,
    "epicPerLevel": {
      "bab": 0.5,
      "fort": 0.5,
      "ref": 0.5,
      "will": 0.5
    }
  },
  "rules": [
    {
      "id": "rule.epic",
      "appliesTo": "each level after 20",
      "text": "Règle maison : BBA et sauvegardes +½ par niveau épique, additionnés en fractions, arrondis une fois",
      "note": "Retrouvé sur la fiche : total 39 / 29 / 35 / 29"
    },
    {
      "id": "rule.hit_points",
      "appliesTo": "each level",
      "text": "Points de vie par niveau = ¾ du dé de vie (d12 → 9, d4 → 3)",
      "note": "Retrouvé sur la fiche : 297 PV de base"
    },
    {
      "id": "rule.experience",
      "appliesTo": "level n",
      "text": "XP requis = n × (n − 1) / 2 × 1000",
      "note": "1 718 250 XP → niveau 59"
    },
    {
      "id": "rule.epic_progression",
      "formula": "Each class level gained at character level > 20 gives +0.5 BAB and +0.5 to each save, whatever the class table says. Fractions are summed across classes and rounded down once."
    },
    {
      "id": "rule.hit_points",
      "formula": "Per level: 3/4 of the hit die (d12 -> 9, d4 -> 3)."
    },
    {
      "id": "rule.experience",
      "formula": "XP needed for level n = n * (n - 1) / 2 * 1000"
    }
  ],
