    {
      "id": "power.temple_raider_of_olidammara_luck_domain",
      "type": "class_power",
      "name": {
        "fr": "Domaine de la Chance",
        "en": "Luck domain"
      },
      "source": "Complete Divine",
      "provenance": "official",
      "labels": [
        "class_power",
        "temple_raider_of_olidammara"
      ],
      "description": {
        "fr": "Un peu de la chance d'Olidammara finit par lui rester collée aux doigts.\n\nEn jeu\n• Il reçoit le pouvoir accordé du domaine de la Chance et ajoute ses sorts du 1er au 4e niveau à sa liste de pilleur de temple (pas aux autres listes).\n• S'il avait déjà ce domaine, il peut utiliser le pouvoir accordé 1 fois de plus par jour."
      },
      "effects": [],
      "note": "Sorts du domaine de la Chance du 1er au 4e niveau : à ajouter à la liste de la classe à la fusion."
    }
