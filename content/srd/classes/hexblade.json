      ],
      "description": {
        "fr": "Sa malédiction mord plus fort.\n\nEn jeu\n• Le malus du tourment passe à −4 (au lieu de −2)."
      },
      "effects": []
    },
    {
      "id": "power.hexblade_aura_of_unluck",
      "type": "class_power",
      "name": {
        "fr": "Aura de malchance",
        "en": "Aura of unluck"
      },
      "provenance": "official",
      "source": "Complete Warrior",
      "labels": [
        "class_power",
        "hexblade"
      ],
      "description": {
        "fr": "Autour de lui, les coups dévient comme si la chance avait changé de camp.\n\nEn jeu\n• Action libre : toute attaque, au corps à corps ou à distance, contre lui a 20 % de chances de rater (comme un camouflage).\n• Dure 3 rounds + son bonus de Charisme (s’il est positif).\n• Une fois par jour au niveau 12, puis une fois de plus aux niveaux 16 et 20."
      },
      "effects": [],
      "usesPerDay": "1 + (if(level('class.hexblade') >= 16, 1, 0)) + (if(level('class.hexblade') >= 20, 1, 0))"
    },
