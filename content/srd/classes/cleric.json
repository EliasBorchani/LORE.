    {
      "id": "power.cleric_turn_undead",
      "type": "class_power",
      "name": {
        "fr": "Renvoi ou intimidation des morts-vivants",
        "en": "Turn or rebuke undead"
      },
      "provenance": "official",
      "labels": [
        "class_power",
        "cleric"
      ],
      "description": {
        "fr": "Le prêtre lève son symbole sacré et prononce le nom de son dieu. Les morts-vivants fuient, s’effondrent en poussière, ou s’agenouillent, selon le dieu.\n\nEn jeu\n• Un prêtre bon renvoie ou détruit les morts-vivants ; un prêtre mauvais les intimide ou les contrôle ; un prêtre neutre choisit une fois pour toutes.\n• Utilisations par jour : 3 + modificateur de Charisme. Action simple.\n• Test de renvoi (1d20 + modificateur de Charisme) pour le plus puissant affecté, puis dégâts de renvoi (2d6 + niveau de prêtre + modificateur de Charisme) en dés de vie affectés.\n• Les morts-vivants de dés de vie au plus la moitié de son niveau sont détruits (ou contrôlés)."
      },
      "effects": [
        {
          "target": "turn_undead.level",
          "op": "add",
          "value": "level('class.cleric')"
        }
      ],
      "usesPerDay": "3 + @ability.cha.mod"
    }
  ],
