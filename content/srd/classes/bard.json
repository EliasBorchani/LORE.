    {
      "id": "power.bard_mass_suggestion",
      "type": "class_power",
      "name": {
        "fr": "Suggestion de groupe",
        "en": "Mass suggestion"
      },
      "provenance": "official",
      "labels": [
        "class_power",
        "bard"
      ],
      "description": {
        "fr": "Toute la salle fascinée reçoit la même idée au même moment. Personne ne se demande d’où elle vient.\n\nEn jeu\n• Demande 21 rangs en Représentation et le niveau 18.\n• Comme suggestion, mais sur toutes les créatures qu’il fascine.\n• Effet mental de langage, enchantement (coercition)."
      },
